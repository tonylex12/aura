datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id // Clerk User ID
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Relations:
  masteries VocabularyMastery[]
  progress  GrammarProgress[]
}

model Vocabulary {
  id          String   @id @default(uuid())
  word        String   @unique
  translation String
  example     String
  category    String   // 'idioms', 'phrasal', 'business', 'travel', 'core'
  createdAt   DateTime @default(now())

  // Relations:
  userMastery VocabularyMastery[]
}

model VocabularyMastery {
  id           String     @id @default(uuid())
  userId       String     // Clerk User ID
  vocabularyId String
  mastered     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // Relations:
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
}

model ChatMessage {
  id          String   @id @default(uuid())
  userId      String   // Clerk User ID
  sender      String   // "aura" | "user"
  text        String
  translation String?
  isVoice     Boolean  @default(false)
  scenario    String   // "casual" | "restaurant" | "interview"
  createdAt   DateTime @default(now())
}

model QuizRecord {
  id          String   @id @default(uuid())
  userId      String   // Clerk User ID
  score       Int      // Number of correct answers
  total       Int      // Total number of questions
  category    String   // 'all', 'idioms', 'phrasal', 'business', 'travel', 'core'
  createdAt   DateTime @default(now())
}

model GrammarLesson {
  id           String   @id @default(uuid())
  title        String   @unique
  category     String   // 'tenses', 'quantifiers', 'rules', 'conditionals'
  summary      String   // Short overview sentence
  formula      String?  // Formula block structure (e.g. S + V)
  content      String   // Detailed text explanation
  examplesJson String   // Stringified JSON list of interactive audio examples
  order        Int      // Sequential sorting index for pagination
  createdAt    DateTime @default(now())

  // Relations:
  userProgress GrammarProgress[]
}

model GrammarProgress {
  id        String        @id @default(uuid())
  userId    String        // Clerk User ID
  lessonId  String
  completed Boolean       @default(false)
  createdAt DateTime      @default(now())

  // Relations:
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    GrammarLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
